[Unit]
Description=homedrive sync agent for %i
Documentation=https://github.com/asnowfix/home-drive/blob/main/homedrive/README.md
After=network-online.target
Wants=network-online.target
# Bounded restarts -- see #88. A crash loop stops after 5 starts within
# 600s and the unit ends `failed`. StartLimit*= belongs in [Unit], not
# [Service], since systemd 230.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=%i
Group=%i
EnvironmentFile=/etc/default/homedrive
EnvironmentFile=-/etc/default/homedrive.%i
ExecCondition=/bin/sh -c 'test -f $(getent passwd %i | cut -d: -f6)/.config/homedrive/config.yaml'
ExecStart=/usr/bin/homedrive run
ExecReload=/bin/kill -HUP $MAINPID
# Startup backoff lives in the agent, not here (systemd 252 has no
# RestartSteps=): remote init is retried 8 times over about 10 min, then the
# agent exits 75 (EX_TEMPFAIL). RestartPreventExitStatus=75 makes that final:
# the unit stays `failed` and needs a manual `systemctl start` once the
# cause (e.g. a rejected credential) is repaired. Any other failure restarts
# after 10s, bounded by StartLimit* above.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=75
StateDirectory=homedrive/%i
LogsDirectory=homedrive/%i

# hardening
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
